# ── Airtable — Lista de espera ────────────────────────────────────────────────
# Crear base en airtable.com con tabla "Lista de Espera"
# Columnas: Nombre, Contacto, Ciudad, Fecha
AIRTABLE_API_KEY=tu_api_key_de_airtable
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Lista de Espera

# ── Cloudflare Turnstile — protección anti-bots ───────────────────────────────
# Crear widget en: https://dash.cloudflare.com → Turnstile → Add site
# Site Key: va aquí Y en Netlify como NEXT_PUBLIC_TURNSTILE_SITE_KEY
# Secret Key: SOLO en el servidor (nunca con prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAAXXXXXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0x4AAAAAAAAXXXXXXXXXXXXXXXXX_SECRET
