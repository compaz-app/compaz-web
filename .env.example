# ── Captación en Supabase ────────────────────────────────────────────────────
# Las postulaciones se guardan solo en Supabase y el CMC las lee de ahí (/api/cmc/postulaciones).
# Fecha ISO desde la que el CMC lee postulaciones de Supabase (lo anterior ya está en el CMC).
# Sin ella, esa ruta responde 503 y el panel no muestra la bandeja de postulaciones por resolver.
CAPTACION_DESDE=

# ── Cloudflare Turnstile — protección anti-bots ───────────────────────────────
# Crear widget en: https://dash.cloudflare.com → Turnstile → Add site
# Site Key: va aquí Y en Netlify como NEXT_PUBLIC_TURNSTILE_SITE_KEY
# Secret Key: SOLO en el servidor (nunca con prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAAXXXXXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0x4AAAAAAAAXXXXXXXXXXXXXXXXX_SECRET

# ── Google Analytics GA4 ──────────────────────────────────────────────────────
# Measurement ID desde: analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Search Console — verificación de dominio ──────────────────────────
# Obtener en: search.google.com/search-console → Agregar propiedad → HTML tag
NEXT_PUBLIC_GSC_VERIFICATION=

DAILY_WEBHOOK_SECRET=
